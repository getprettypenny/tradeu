# Copy this file to .env.local (gitignored) for local dev, and set the
# same variable in your host's environment variable settings for
# production. Falls back to the endpoint already hardcoded in
# src/lib/formspree.js if this isn't set.
VITE_FORMSPREE_URL=https://formspree.io/f/mzebznla

# Meta (Facebook/Instagram) Pixel ID, from Business Suite -> Events
# Manager -> Connect a data source -> Web -> Meta Pixel. Optional: if
# this isn't set, src/lib/pixel.js is a complete no-op and nothing
# Meta-related loads at all.
VITE_META_PIXEL_ID=
